<!DOCTYPE html>
<html lang="{{ site.langue }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ description }}">
    <meta name="author" content="{{ site.professeure }}">

    {% if beta or noindex %}
    {# Deux cas d'exclusion de l'index : la version d'essai, qui ferait
       doublon avec le site en ligne, et la page d'erreur 404, qui n'a rien
       a faire dans les resultats de recherche. #}
    <meta name="robots" content="noindex, nofollow">
    {% endif %}

    {# Adresse de reference de la page : evite que /page.html et /page
       soient vus par Google comme deux pages differentes. #}
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">

    <title>{{ title }}</title>

    <!-- Open Graph -->
    <meta property="og:site_name" content="{{ site.nom }}">
    <meta property="og:locale" content="fr_FR">
    <meta property="og:title" content="{{ ogTitle or title }}">
    <meta property="og:description" content="{{ ogDescription or description }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:image" content="{{ site.url }}{{ site.ogImage }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Théâtre 17 — cours de théâtre et d'éloquence avec {{ site.professeure }}">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ ogTitle or title }}">
    <meta name="twitter:description" content="{{ ogDescription or description }}">
    <meta name="twitter:image" content="{{ site.url }}{{ site.ogImage }}">

    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png">
    <link rel="manifest" href="/favicon/site.webmanifest">

    {# Polices servies par notre propre domaine : aucune requete vers
       Google, donc aucune transmission d'adresse IP des visiteurs. #}
    <link rel="preload" href="/fonts/playfair-display-400-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/source-sans-3-300-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="{{ '/css/fonts.css' | empreinte }}">
    <link rel="stylesheet" href="{{ '/css/style.css' | empreinte }}">

    {# Donnees structurees : c'est ce qui permet a Google de comprendre
       qu'il s'agit d'une activite locale d'enseignement, et non d'un
       site quelconque.

       Les valeurs passent toutes par « | dump | safe » et non par une
       simple interpolation entre guillemets. Raison : Nunjucks echappe
       automatiquement pour le HTML et transforme l'apostrophe en &#39; —
       or les entites HTML ne sont pas decodees a l'interieur d'un <script>.
       Google lisait donc mot pour mot « rue de l&#39;Atlas ». Le filtre
       dump produit une chaine JSON correctement echappee, guillemets
       compris, et safe empeche le second echappement. #}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "@id": {{ (site.url + "/#organisation") | dump | safe }},
      "name": {{ site.nom | dump | safe }},
      "description": {{ "Cours de théâtre et d'éloquence pour enfants, adolescents et adultes en Charente-Maritime." | dump | safe }},
      "url": {{ site.url | dump | safe }},
      "telephone": {{ site.contact.telephoneLien | dump | safe }},
      "email": {{ site.contact.email | dump | safe }},
      "image": {{ (site.url + site.ogImage) | dump | safe }},
      "address": {
        "@type": "PostalAddress",
        "streetAddress": {{ site.legal.adresse | dump | safe }},
        "postalCode": {{ site.legal.codePostal | dump | safe }},
        "addressLocality": {{ site.legal.ville | dump | safe }},
        "addressCountry": {{ site.legal.pays | dump | safe }}
      },
      "areaServed": [
        {%- for zone in site.zonesDesservies %}
        { "@type": {{ zone.type | dump | safe }}, "name": {{ zone.nom | dump | safe }} }{% if not loop.last %},{% endif %}
        {%- endfor %}
      ],
      {# Les salles ou les cours ont lieu. L'adresse ci-dessus est l'adresse
         legale de l'entreprise, celle qui figure aux mentions legales ; ces
         lieux-ci sont les adresses reelles ou l'on se rend. Les declarer
         rattache l'activite a la Charente-Maritime.
         Chacun porte un @id : les pages de cours s'y referent au lieu de
         redecrire l'adresse, et ce bloc etant present sur toutes les pages,
         la reference se resout toujours localement. #}
      "hasPOS": [
        {%- for salle in site.lieux %}
        {
          "@type": "Place",
          "@id": {{ (site.url + "/#" + salle.id) | dump | safe }},
          "name": {{ salle.nom | dump | safe }},
          "address": {
            "@type": "PostalAddress",
            "streetAddress": {{ salle.rue | dump | safe }},
            "postalCode": {{ salle.codePostal | dump | safe }},
            "addressLocality": {{ salle.ville | dump | safe }},
            "addressRegion": "Charente-Maritime",
            "addressCountry": "FR"
          }
        }{% if not loop.last %},{% endif %}
        {%- endfor %}
      ],
      "founder": {
        "@type": "Person",
        "@id": {{ (site.url + "/#emmanuelle") | dump | safe }},
        "name": {{ site.professeure | dump | safe }},
        "jobTitle": {{ "Professeure de théâtre et d'éloquence" | dump | safe }}
      }
    }
    </script>
    {% if jsonLd %}
    <script type="application/ld+json">{{ jsonLd | safe }}</script>
    {% endif %}

    {% if page.url == "/" %}
    {# Nom du site affiche au-dessus du resultat Google. Sans ce bloc, Google
       le devine — et il choisissait « Emmanuelle Foltete », le seul nom propre
       que portait l'ancien titre. Google ne lit ce noeud que sur la page
       d'accueil, d'ou la condition. #}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": {{ (site.url + "/#site") | dump | safe }},
      "name": {{ site.nom | dump | safe }},
      "alternateName": {{ "Théâtre 17 — Emmanuelle Foltête" | dump | safe }},
      "url": {{ (site.url + "/") | dump | safe }},
      "inLanguage": "fr",
      "publisher": { "@id": {{ (site.url + "/#organisation") | dump | safe }} }
    }
    </script>
    {% endif %}

    {%- set filAriane = page.url | libelleNav(site.nav) %}
    {% if filAriane %}
    {# Fil d'Ariane : c'est ce qui permet a Google d'afficher
       « theatre17.fr › Dompierre » sous le titre du resultat, plutot que
       l'adresse brute. #}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Accueil",
          "item": {{ (site.url + "/") | dump | safe }}
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ filAriane | dump | safe }},
          "item": {{ (site.url + page.url) | dump | safe }}
        }
      ]
    }
    </script>
    {% endif %}
</head>
<body>
    <a href="#contenu" class="skip-link">Aller au contenu</a>

    {% if beta %}
    <p class="bandeau-beta">
        Version d'essai — le site en ligne reste
        <a href="https://theatre17.fr/">theatre17.fr</a>
    </p>
    {% endif %}

    {% include "partials/header.njk" %}

    <main id="contenu">
        {{ content | safe }}
    </main>

    {% include "partials/footer.njk" %}
    {% include "partials/bandeau-cookies.njk" %}
    {% include "partials/modale-cookies.njk" %}

    <script src="{{ '/js/main.js' | empreinte }}" defer></script>
</body>
</html>
