{# En-tete unique du site. Modifier ce fichier met a jour toutes les pages. #}
<header class="site-header">
    <div class="container header-bar">
        <a href="/" class="brand">
            <span class="brand__nom">Théâtre <span>17</span></span>
            <span class="brand__prof">{{ site.professeure }}</span>
        </a>

        <nav class="site-nav" aria-label="Navigation principale">
            <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="menu-principal" aria-label="Ouvrir le menu">Menu</button>
            <ul id="menu-principal">
                {%- for lien in site.nav %}
                <li>
                    <a href="{{ lien.url }}"
                       {% if lien.url == page.url %}class="is-active" aria-current="page"{% endif %}>{{ lien.texte }}</a>
                </li>
                {%- endfor %}
            </ul>
        </nav>
    </div>
</header>
